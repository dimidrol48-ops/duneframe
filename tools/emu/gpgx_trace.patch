+unsigned int trace_free[TRACE_FREE_MAX * 2], trace_free_n, trace_free_on, trace_free_sp;
+
+void *retro_trace_get(int which)
+{
+  switch (which) {
+    case 0: return trace_exec;
+    case 1: return trace_read;
+    case 2: return trace_reader;
+    case 3: return trace_ramexec;
+    case 4: return &trace_enabled;
