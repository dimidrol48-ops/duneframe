+unsigned int trace_reglog[TRACE_REG_MAX*17]; unsigned int trace_reg_n, trace_reg_i0 = 0xFFFFFFFF, trace_reg_i1;
+unsigned int trace_ss_pcs[16] = {0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF,0xFFFFFFFF};
+unsigned int trace_ss_taken[16], trace_ss_count[16], trace_ss_n, trace_ss_max, trace_ss_stride = 1, trace_ss_lo = 0xFFFFFFFF, trace_ss_hi;
+unsigned char trace_ss_buf[TRACE_SS_MAX*TRACE_SS_SIZE];
