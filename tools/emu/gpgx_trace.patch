@@ -0,0 +1,54 @@
+/* ROM analysis tracing hooks (added for disassembly work) */
+#ifndef TRACE_H
+#define TRACE_H
+#define TRACE_ROM_SIZE 0x400000
+extern unsigned char trace_exec[TRACE_ROM_SIZE];   /* bit0: instruction start executed */
+extern unsigned char trace_read[TRACE_ROM_SIZE];   /* bit0: byte read, bit1: word read, bit2: long read, bit3: long read value in ROM range,
+                                                      bit4: pc-relative read, bit5: VDP DMA source, bit6: Z80 bank read */
+extern unsigned int  trace_reader[TRACE_ROM_SIZE/2];/* first PC that read this word */
+extern unsigned int  trace_cur_pc;
+extern int trace_enabled;
+extern unsigned int trace_hist[TRACE_ROM_SIZE/2]; /* per-PC execution counts (when trace_hist_on) */
+extern int trace_hist_on;
+#define TRACE_PCLOG_MAX (1<<21)
+extern unsigned int trace_pclog[TRACE_PCLOG_MAX*2]; /* pc, cycles */
+extern unsigned int trace_pclog_n; extern int trace_pclog_on;
+#define TRACE_REG_MAX (1<<18)
+extern unsigned int trace_reglog[TRACE_REG_MAX*17]; extern unsigned int trace_reg_n, trace_reg_i0, trace_reg_i1;
+#define TRACE_CW_MAX (1<<16)
+extern unsigned int trace_cw_pcs[16], trace_cw_n, trace_cw_log[TRACE_CW_MAX*17];
+/* RAM snapshots at up to 16 PCs: regs d0-a7, SR, PC (18 words) then 64KB work RAM (as stored) */
+#define TRACE_SS_MAX 256
+#define TRACE_SS_SIZE (18*4 + 0x10000)
+extern unsigned int trace_ss_pcs[16], trace_ss_taken[16], trace_ss_count[16], trace_ss_n, trace_ss_max, trace_ss_stride, trace_ss_lo, trace_ss_hi;
+extern unsigned char trace_ss_buf[TRACE_SS_MAX*TRACE_SS_SIZE];
+#define TRACE_RW_MAX (1<<20)
+extern unsigned int trace_rw_pc, trace_rw_n, trace_rw_log[TRACE_RW_MAX*3]; /* reads done by instruction at trace_rw_pc */
+static inline void trace_rwatch(unsigned int a, unsigned int v) { if ((trace_cur_pc == trace_rw_pc || trace_rw_pc == 0xFFFFFFFEu) && trace_rw_n < TRACE_RW_MAX) { trace_rw_log[trace_rw_n*3] = trace_cur_pc; trace_rw_log[trace_rw_n*3+1] = a & 0xFFFFFF; trace_rw_log[trace_rw_n*3+2] = v; trace_rw_n++; } }
+extern unsigned char trace_ramexec[0x10000];
+extern unsigned char trace_rclass[TRACE_ROM_SIZE];
+extern unsigned char trace_rclass_ram[TRACE_ROM_SIZE]; /* same classes, for ROM longs later read back from RAM copies */
+extern unsigned int  trace_shadow[0x8000];          /* RAM word -> ROM origin+1 of the long stored there */
+extern unsigned int  trace_last_origin, trace_last_val;
+extern unsigned int  trace_watch_lo, trace_watch_hi, trace_watch_n, trace_watch_log[4096*3]; /* write watchpoint: pc, addr, value */
+static inline void trace_watch(unsigned int a, unsigned int v) { a &= 0xFFFFFF; if (a >= trace_watch_lo && a < trace_watch_hi && trace_watch_n < 4096) { trace_watch_log[trace_watch_n*3] = trace_cur_pc; trace_watch_log[trace_watch_n*3+1] = a; trace_watch_log[trace_watch_n*3+2] = v; trace_watch_n++; } }
+static inline int trace_irclass(unsigned int ir) { return ((ir & 0xF1C0) == 0x2040) ? 1 : ((ir & 0xFFC0) == 0x2F00) ? 2 : ((ir & 0xF1C0) == 0x2000) ? 4 : 8; } /* long-read classes: 1 movea.l, 2 push, 4 move.l->Dn, 8 other */
+static inline int trace_rd(unsigned int addr, int flag) { unsigned int _a=addr&0xFFFFFF; if (_a < TRACE_ROM_SIZE) { trace_read[_a] |= flag; if (!trace_reader[_a>>1]) trace_reader[_a>>1]=trace_cur_pc; } return 0; }
+#define TRACE_RD(addr,flag) trace_rd((addr),(flag))
+#endif
+
+/* free execution: instructions at PCs inside these ranges take no CPU time
+ * (used to give two builds identical timing, see tools/lockstep.py) */
+#define TRACE_FREE_MAX 512
+extern unsigned int trace_free[TRACE_FREE_MAX * 2], trace_free_n, trace_free_on, trace_free_sp;
+static inline int trace_is_free(unsigned int pc)
+{
+  unsigned int lo = 0, hi = trace_free_n;
+  while (lo < hi) {               /* ranges sorted by start */
+    unsigned int m = (lo + hi) >> 1;
+    if (pc < trace_free[m * 2]) hi = m;
+    else if (pc >= trace_free[m * 2 + 1]) lo = m + 1;
+    else return 1;
+  }
+  return 0;
+}
