+    case 20: return &trace_reg_n;
+    case 21: return &trace_reg_i0;
+    case 22: return &trace_reg_i1;
+    case 23: return trace_cw_pcs;
+    case 24: return &trace_cw_n;
+    case 25: return trace_cw_log;
+    case 26: return vram;
+    case 27: return cram;
+    case 28: return vsram;
+    case 29: return reg;
+    case 30: return trace_ss_pcs;
