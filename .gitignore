# ROM-derived files: never commit (see CLAUDE.md / docs/TECHNICAL.md).
# make setup regenerates all of these from baserom.gen.

# the ROMs themselves
baserom.gen
variants/*.gen
*.zip

# generated disassembly sources (src/c/ and src/autoplay.inc stay committed)
src/*.s
src/*.inc
!src/autoplay.inc
src/files.txt
src/bin/

# generated assets
assets/gfx/
assets/palettes/
assets/sound/

# build outputs, test artifacts, screenshots, save states, RAM dumps
build/
tools/emu/build/
tools/med/mednafen/
OUT/
autoplay.bin
__pycache__/
